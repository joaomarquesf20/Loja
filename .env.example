# ──────────────────────────────────────────────────────────────────────────────
# Template white-label de loja de peças automóvel — variáveis de ambiente
# Copia este ficheiro para `.env` (desenvolvimento local) e preenche os valores.
# Em produção define-as no provedor (Vercel → Project → Settings → Environment
# Variables, Docker/env, etc.). Nunca comitas o `.env` real.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Base de dados (obrigatório) ─────────────────────────────────────────────
# String de ligação PostgreSQL usada pelo Prisma (migrações e runtime).
# Drivers: usa PostgreSQL 14+ (o adaptador usado é @prisma/adapter-pg).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/store"

# ─── Autenticação (NextAuth) (obrigatório) ───────────────────────────────────
# URL público da loja. Também alimenta metadataBase (Open Graph), robots.ts e
# sitemap.ts. Em produção: https://a-tua-loja.pt
NEXTAUTH_URL="http://localhost:3000"
# Segredo de assinatura/cookies das sessões. Gera um novo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="CHANGE_ME_WITH_A_LONG_RANDOM_SECRET"

# ─── Emails transacionais (Resend) (opcional) ────────────────────────────────
# Sem RESEND_API_KEY o envio entra em modo de simulação: o email é registado
# no log do servidor e nunca é enviado — útil para desenvolver sem conta Resend.
RESEND_API_KEY=""
# Remetente dos emails transacionais no formato "Nome <email>".
# O nome aparece nos emails de encomenda; usa a identidade da tua loja.
EMAIL_FROM=""

# ─── Pagamentos Stripe (opcional) ────────────────────────────────────────────
# Chaves do dashboard Stripe (test/live). Sem STRIPE_SECRET_KEY o checkout
# entra em modo simulado (disponível apenas fora de produção; pagamentos
# simulados NUNCA são servidos em produção).
STRIPE_SECRET_KEY=""
# Assinatura do webhook Stripe (Dashboard → Developers → Webhooks → endpoint
# /api/payments/webhook). Necessária para confiar nos eventos em produção.
STRIPE_WEBHOOK_SECRET=""

# ─── Webhook interno de pagamentos ───────────────────────────────────────────
# Segredo com que as entregas do webhook /api/payments/webhook vêm assinadas
# (mínimo 32 carateres aleatórios).
PAYMENT_WEBHOOK_SECRET="CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
# Rotação do segredo: durante a troca, mantém aqui o segredo anterior para que
# entregas assinadas com o segredo antigo continuem válidas até à sobreposição
# terminar.
PAYMENT_WEBHOOK_SECRET_PREVIOUS=""
# Tolerância do timestamp da assinatura, em segundos
# (default 300 = ±5 minutos; permitido 1..86400).
PAYMENT_WEBHOOK_MAX_AGE_SECONDS="300"

# ─── Armazenamento de imagens de produto ─────────────────────────────────────
# "local" (default): guarda imagens no disco da instância — só para
#   desenvolvimento (a Vercel rejeita disco local).
# "vercel-blob": armazenamento persistente na Vercel (requer
#   BLOB_READ_WRITE_TOKEN da loja Vercel Blob — ver projeto → @vercel/blob).
PRODUCT_IMAGE_STORAGE="local"
# Só para "local": pasta local das imagens e path público correspondente.
PRODUCT_IMAGE_UPLOAD_DIR="./public/uploads/products"
PRODUCT_IMAGE_PUBLIC_PATH="/uploads/products"
# Token Vercel Blob (só para PRODUCT_IMAGE_STORAGE=vercel-blob).
BLOB_READ_WRITE_TOKEN=""
