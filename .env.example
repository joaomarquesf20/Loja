DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/pfautoparts"
NEXTAUTH_SECRET="CHANGE_ME_WITH_A_LONG_RANDOM_SECRET"
NEXTAUTH_URL="http://localhost:3000"
PAYMENT_WEBHOOK_SECRET="CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
# Simulated payments are disabled in production. Set to "true" only for demos; never enable on a live store.
PFA_ENABLE_SIMULATED_PAYMENTS="false"
# Development-only local image storage. Replace the adapter for production object storage.
PRODUCT_IMAGE_STORAGE="local"
PRODUCT_IMAGE_UPLOAD_DIR="./public/uploads/products"
PRODUCT_IMAGE_PUBLIC_PATH="/uploads/products"
