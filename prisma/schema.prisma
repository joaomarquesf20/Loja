generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  SELLER
  BUYER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  READY_FOR_PICKUP
  PICKED_UP
  CANCELLED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  INSTALLMENTS
}

enum OrderEventType {
  PAYMENT_CONFIRMED
  PAYMENT_FAILED
  PAYMENT_RETRIED
  STATUS_CHANGED
  PAYMENT_REFUNDED
  CANCELLED
}

enum FulfillmentMethod {
  DELIVERY
  PICKUP
}

enum ShippingClass {
  UNASSIGNED
  SMALL
  STANDARD
  BULKY
  HEAVY
  QUOTE_REQUIRED
}

enum CheckoutRegion {
  PORTUGAL_MAINLAND
  MADEIRA
  AZORES
  INTERNATIONAL
}

enum ShippingMethod {
  STANDARD
  EXPRESS
}

enum StockMovementType {
  RESTOCK
  SALE
  MANUAL_ADJUSTMENT
  RETURN
}

/// Épico 7 — tipo de desconto de um cupão: percentagem do carrinho ou
/// valor fixo em euros.
enum CouponDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model User {
  id                         String           @id @default(cuid())
  email                      String           @unique
  passwordHash               String
  name                       String?
  role                       UserRole         @default(BUYER)
  isActive                   Boolean          @default(true)
  failedLoginAttempts        Int              @default(0)
  failedLoginWindowStartedAt DateTime?
  loginBlockedUntil          DateTime?
  addresses                  Address[]        @relation("UserAddresses")
  defaultAddressId           String?          @unique
  defaultAddress             Address?         @relation("UserDefaultAddress", fields: [defaultAddressId], references: [id], onDelete: SetNull)
  cartItems                  CartItem[]
  guestCartMerges            GuestCartMerge[]
  orders                     Order[]
  stockMovements             StockMovement[]
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt
}

/// Épico 8 — motor de compatibilidade: marca de veículo (make).
model VehicleMake {
  id                     String                 @id @default(cuid())
  name                   String                 @unique
  slug                   String                 @unique
  createdAt              DateTime             @default(now())
  models                 VehicleModel[]

  @@index([slug])
}

/// Épico 8 — modelo de veículo pertencente a uma marca.
model VehicleModel {
  id                     String                 @id @default(cuid())
  makeId                 String
  name                   String
  slug                   String
  createdAt              DateTime               @default(now())
  make                   VehicleMake            @relation(fields: [makeId], references: [id], onDelete: Cascade)
  specs                  VehicleSpec[]

  @@unique([makeId, slug])
  @@index([makeId])
}

/// Épico 8 — especificação de compatibilidade (fitment) de um modelo:
/// motor + código do motor + intervalo de anos + combustível + potência.
/// É a unidade atómica de compatibilidade com produtos.
model VehicleSpec {
  id                     String                 @id @default(cuid())
  modelId                String
  /// Designação comercial do motor (ex.: "1.5 TD").
  engine                 String
  /// Código interno do motor (ex.: "4EC1-T"); opcional.
  engineCode             String?
  /// Primeiro ano de aplicação (inclusive).
  yearStart              Int
  /// Último ano de aplicação (inclusive); null = em produção.
  yearEnd                Int?
  /// Tipo de combustível em maiúsculas (ex.: "DIESEL").
  fuelType               String
  /// Potência em cavalos (cv); opcional.
  powerHp                Int?
  createdAt              DateTime               @default(now())
  model                  VehicleModel           @relation(fields: [modelId], references: [id], onDelete: Cascade)
  productCompatibilities ProductCompatibility[]

  @@unique([modelId, engine, yearStart])
  @@index([modelId])
}

model Category {
  id          String     @id @default(cuid())
  parentId    String?
  name        String
  slug        String     @unique
  description String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]

  @@index([slug])
}

model ProductBrand {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  products Product[]

  @@index([slug])
}

model Product {
  id              String                        @id @default(cuid())
  categoryId      String
  productBrandId  String?
  name            String
  slug            String                        @unique
  sku             String                        @unique
  description     String?
  isActive        Boolean                       @default(true)
  images          String[]                      @default([])
  defaultFinish   String?
  shippingClass   ShippingClass                 @default(UNASSIGNED)
  category        Category                      @relation(fields: [categoryId], references: [id])
  brand           ProductBrand?                 @relation(fields: [productBrandId], references: [id])
  compatibilities ProductCompatibility[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  shippingRates   ProductShippingRate[]
  variants        ProductVariant[]
  options         ProductOption[]
  imageMetadata   ProductImage[]
  createdAt       DateTime                      @default(now())

  @@index([categoryId])
  @@index([shippingClass])
  @@index([createdAt])
}

model ProductVariant {
  id                     String                               @id @default(cuid())
  productId              String
  sku                    String                               @unique
  supplierSku            String?
  price                  Decimal                              @db.Decimal(10, 2)
  priceSet               Decimal?                             @db.Decimal(10, 2)
  stockQuantity          Int                                  @default(0)
  isActive               Boolean                              @default(true)
  /// Épico 6 — limiar de stock baixo a nível de variante. Quando
  /// definido, o estado LOW_STOCK é calculado com este valor em vez
  /// do limiar global da consulta; null volta a usar o global.
  lowStockThreshold      Int?
  images                 String[]
  position               Int                                  @default(0)
  optionKey              String
  product                Product                              @relation(fields: [productId], references: [id], onDelete: Cascade)
  selections             ProductVariantOptionSelection[]
  specifications         ProductVariantSpecification[]
  cartItems              CartItem[]
  orderItems             OrderItem[]
  movements              StockMovement[]

  @@unique([productId, optionKey])
  @@index([productId, position])
  @@index([productId, isActive, position])
}

/**
 * Épico 6 — registo histórico de movimentos de stock: cada alteração
 * de stock de uma variante (reposição, venda, correção manual ou
 * reposição por cancelamento) é gravada numa linha desta tabela dentro
 * da MESMA transação que altera o stock, garantindo atomicidade.
 */
model StockMovement {
  id             String            @id @default(cuid())
  variantId      String
  productVariant ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantityChange Int
  previousStock  Int
  newStock       Int
  type           StockMovementType
  actorUserId    String?
  actorUser      User?             @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())

  @@index([variantId, createdAt])
  @@index([createdAt])
}

/**
 * Épico 7 — cupão de desconto. `code` é único e NORMALIZADO em
 * maiúsculas pelo serviço. Os limites (`maxUses`, `usedCount`) são
 * impostos atomicamente com `updateMany` guardado — ver
 * `src/server/coupons.ts`. `discountValue` em euros (FIXED_AMOUNT) ou
 * percentagem (PERCENTAGE); `minOrderValue` refere-se ao subtotal de
 * produtos do carrinho.
 */
model Coupon {
  id            String             @id @default(cuid())
  code          String             @unique
  discountType  CouponDiscountType
  discountValue Float
  minOrderValue Float?
  maxUses       Int?
  usedCount     Int                @default(0)
  startsAt      DateTime?
  expiresAt     DateTime?
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model ProductOption {
  id        String               @id @default(cuid())
  productId String
  name      String
  code      String
  position  Int                  @default(0)
  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values    ProductOptionValue[]

  @@unique([productId, code])
  @@index([productId, position])
}

model ProductOptionValue {
  id            String                          @id @default(cuid())
  optionId      String
  value         String
  position      Int                             @default(0)
  option        ProductOption                   @relation(fields: [optionId], references: [id], onDelete: Cascade)
  selections    ProductVariantOptionSelection[]
  productImages ProductImage[]                  @relation("ProductImageFinishValue")

  @@unique([optionId, value])
  @@unique([id, optionId])
  @@index([optionId, position])
}

model ProductImage {
  id            String              @id @default(cuid())
  productId     String
  url           String
  altText       String?
  sortOrder     Int                 @default(0)
  isPrimary     Boolean             @default(false)
  finishValueId String?
  product       Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  finishValue   ProductOptionValue? @relation("ProductImageFinishValue", fields: [finishValueId], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder])
  @@index([finishValueId])
}

model ProductVariantOptionSelection {
  variantId     String
  optionId      String
  optionValueId String
  variant       ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue   ProductOptionValue @relation(fields: [optionValueId, optionId], references: [id, optionId], onDelete: Cascade)

  @@id([variantId, optionId])
  @@index([optionValueId, optionId])
}

model ProductVariantSpecification {
  id        String         @id @default(cuid())
  variantId String
  key       String
  label     String
  value     String
  unit      String?
  position  Int            @default(0)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, key])
  @@index([variantId, position])
}

/// Épico 8 — compatibilidade de um PRODUTO (nível de produto, não de
/// variante) com uma especificação de veículo. Única por par
/// (produto, especificação); notas livres do administrador.
model ProductCompatibility {
  id            String      @id @default(cuid())
  productId     String
  vehicleSpecId String
  /// Nota opcional do administrador (ex.: "requer apoios originais").
  notes         String?
  createdAt     DateTime    @default(now())
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  vehicleSpec   VehicleSpec @relation(fields: [vehicleSpecId], references: [id], onDelete: Cascade)

  @@unique([productId, vehicleSpecId])
  @@index([vehicleSpecId])
}

model CartItem {
  id               String         @id @default(cuid())
  userId           String
  productId        String
  productVariantId String
  quantity         Int            @default(1)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  product          Product        @relation(fields: [productId], references: [id])
  variant          ProductVariant @relation(fields: [productVariantId], references: [id])

  @@unique([userId, productVariantId])
  @@index([productId])
  @@index([productVariantId])
}

model GuestCartMerge {
  id              String   @id @default(cuid())
  mergeKey        String   @unique
  userId          String
  payloadHash     String
  mergedItemCount Int
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Address {
  id             String  @id @default(cuid())
  userId         String?
  name           String
  addressLine1   String
  addressLine2   String?
  city           String
  postalCode     String
  country        String
  user           User?   @relation("UserAddresses", fields: [userId], references: [id])
  defaultForUser User?   @relation("UserDefaultAddress")

  @@index([userId])
}

model StoreSettings {
  id               String   @id @default("store")
  pricesIncludeTax Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model CheckoutRegionRule {
  region              CheckoutRegion @id
  checkoutEnabled     Boolean        @default(false)
  taxRatePercent      Decimal?       @db.Decimal(5, 2)
  expressShippingCost Decimal?       @db.Decimal(10, 2)
  shippingRules       ShippingRule[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model ShippingRule {
  id                    String             @id @default(cuid())
  region                CheckoutRegion
  shippingClass         ShippingClass
  checkoutEnabled       Boolean            @default(false)
  shippingCost          Decimal?           @db.Decimal(10, 2)
  maximumShippingCost   Decimal?           @db.Decimal(10, 2)
  freeShippingThreshold Decimal?           @db.Decimal(10, 2)
  regionRule            CheckoutRegionRule @relation(fields: [region], references: [region], onDelete: Restrict)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@unique([region, shippingClass])
  @@index([shippingClass])
}

model ProductShippingRate {
  id           String         @id @default(cuid())
  productId    String
  region       CheckoutRegion
  shippingCost Decimal        @db.Decimal(10, 2)
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([productId, region])
  @@index([region])
}

model Order {
  id                      String            @id @default(cuid())
  orderNumber             String            @unique
  userId                  String?
  subtotal                Decimal           @db.Decimal(10, 2)
  shippingCost            Decimal           @db.Decimal(10, 2)
  tax                     Decimal           @default(0) @db.Decimal(10, 2)
  total                   Decimal           @db.Decimal(10, 2)
  /// Épico 7 — código do cupão aplicado na compra (normalizado em
  /// maiúsculas; null = sem cupão). Snapshot no momento da criação.
  couponCode              String?
  /// Épico 7 — desconto do cupão aplicado ao subtotal (em euros).
  /// O `total` é o valor FINAL (subtotal − desconto + portes).
  discountAmount          Decimal?          @db.Decimal(10, 2)
  /// Épico 7 — etapa 2: marca temporal da reversão do uso do cupão
  /// (anulação/reembolso). `null` = uso ainda contabilizado; o marcador
  /// garante que reembolso seguido de cancelamento só devolve o uso
  /// uma vez (idempotência dentro da transação de transição).
  couponReversedAt        DateTime?
  status                  OrderStatus       @default(PENDING)
  paymentStatus           PaymentStatus     @default(PENDING)
  paymentMethod           PaymentMethod?
  installmentCount        Int?
  paymentProvider         String?
  paymentReference        String?
  /**
   * Data da confirmação efetiva do pagamento. É preenchida quando o estado
   * de pagamento passa para PAID (ex.: webhook do Stripe), para suportar
   * controlo de fulfillment sem dependência de OrderEvent.
   */
  paidAt                  DateTime?
  fulfillmentMethod       FulfillmentMethod @default(DELIVERY)
  shippingMethod          ShippingMethod?
  shippingName            String
  shippingEmail           String
  shippingPhone           String
  shippingAddressLine1    String?
  shippingAddressLine2    String?
  shippingCity            String?
  shippingPostalCode      String?
  shippingCountry         String?
  shippingRegion          CheckoutRegion?
  shippingClassApplied    ShippingClass?
  taxRatePercent          Decimal?          @db.Decimal(5, 2)
  pricesIncludeTax        Boolean?
  nonVolumousSubtotal     Decimal?          @db.Decimal(10, 2)
  nonVolumousShippingCost Decimal?          @db.Decimal(10, 2)
  bulkyShippingCost       Decimal?          @db.Decimal(10, 2)
  freeShippingThreshold   Decimal?          @db.Decimal(10, 2)
  freeShippingApplied     Boolean?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  user                    User?             @relation(fields: [userId], references: [id])
  items                   OrderItem[]
  events                  OrderEvent[]

  @@unique([paymentProvider, paymentReference])
  @@index([orderNumber])
}

model OrderItem {
  id                       String         @id @default(cuid())
  orderId                  String
  productId                String
  productVariantId         String
  productNameAtPurchase    String
  productSkuAtPurchase     String
  priceAtPurchase          Decimal        @db.Decimal(10, 2)
  quantity                 Int
  subtotalAtPurchase       Decimal        @db.Decimal(10, 2)
  variantOptionsAtPurchase Json
  shippingClassAtPurchase  ShippingClass?
  shippingCostAtPurchase   Decimal?       @db.Decimal(10, 2)
  order                    Order          @relation(fields: [orderId], references: [id])
  product                  Product        @relation(fields: [productId], references: [id])
  variant                  ProductVariant @relation(fields: [productVariantId], references: [id])

  @@unique([orderId, productVariantId])
  @@index([productId])
  @@index([productVariantId])
}

model OrderEvent {
  id                String         @id @default(cuid())
  orderId           String
  type              OrderEventType
  fromOrderStatus   OrderStatus?
  toOrderStatus     OrderStatus?
  fromPaymentStatus PaymentStatus?
  toPaymentStatus   PaymentStatus?
  createdAt         DateTime       @default(now())
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model ProductImport {
  id              String    @id @default(cuid())
  fileName        String
  mode            String
  failureMode     String    @default("abort")
  status          String
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  createdBy       String?
  createdProducts Int       @default(0)
  updatedProducts Int       @default(0)
  createdVariants Int       @default(0)
  updatedVariants Int       @default(0)
  /**
   * Imagens novas criadas pelo import.
   */
  createdImages   Int       @default(0)
  /**
   * Imagens já existentes e reutilizadas (dedupe por produto+finish+URL).
   */
  matchedImages   Int       @default(0)
  errorCount      Int       @default(0)
  errors          Json      @default("[]")
  warnings        Json      @default("[]")
  changes         Json      @default("[]")

  @@index([startedAt])
}
